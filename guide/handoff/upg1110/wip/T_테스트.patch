+_TOK = re.compile(r'''(?P<ws>\s+)|(?P<lc>//[^\n]*)|(?P<bc>/\*.*?\*/)|(?P<s>'(?:\\.|[^'\\\n])*'|"(?:\\.|[^"\\\n])*")|(?P<n>0[xX][0-9a-fA-F]+|\d+\.?\d*(?:[eE][+-]?\d+)?n?|\.\d+)|(?P<id>[A-Za-z_$ -￿][\w$ -￿]*)|(?P<p>=>|\.\.\.|===|!==|==|!=|<=|>=|&&=|\|\|=|\?\?=|&&|\|\||\?\?|\?\.|\+\+|--|\*\*=|\*\*|<<=|>>>=|>>=|<<|>>>|>>|[-+*/%&|^]=|[{}()\[\];,.<>+\-*/%&|^!~?:=@#\\])''', re.S)
